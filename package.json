{
  "name": "deer-ui",
  "version": "0.1.0",
  "private": true,
  "description": "deer-ui — 独立的 React 18 控件库：控件的 DOM 契约、行为与无障碍属性，自带设计令牌与控件样式（deer-ui/styles.css），零运行时依赖（react/react-dom 仅为 peer）。双格式产物：ESM 在 dist/（原生 import）、CJS 在 dist/cjs/（原生 require），两条路都由 exports 的 import/require 条件给出；相对 import 一律带 .js 后缀（NodeNext 语义）；v0 不发 npm，只以 tarball 交付（见 README）。",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./kit": {
      "import": {
        "types": "./dist/kit/index.d.ts",
        "default": "./dist/kit/index.js"
      },
      "require": {
        "types": "./dist/cjs/kit/index.d.cts",
        "default": "./dist/cjs/kit/index.cjs"
      }
    },
    "./tabs": {
      "import": {
        "types": "./dist/tabs.d.ts",
        "default": "./dist/tabs.js"
      },
      "require": {
        "types": "./dist/cjs/tabs.d.cts",
        "default": "./dist/cjs/tabs.cjs"
      }
    },
    "./tooltip": {
      "import": {
        "types": "./dist/tooltip.d.ts",
        "default": "./dist/tooltip.js"
      },
      "require": {
        "types": "./dist/cjs/tooltip.d.cts",
        "default": "./dist/cjs/tooltip.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/cjs/index.d.cts",
  "main": "./dist/cjs/index.cjs",
  "scripts": {
    "typecheck": "node scripts/tsc.mjs -p tsconfig.json --noEmit && node scripts/tsc.mjs -p tsconfig.examples.json --module esnext --moduleResolution bundler",
    "build": "node scripts/tsc.mjs -p tsconfig.build.json && node scripts/tsc.mjs -p tsconfig.cjs.json && node scripts/build-styles.mjs",
    "test:build": "node scripts/tsc.mjs -p tests/tsconfig.json",
    "test": "node scripts/tsc.mjs -p tests/tsconfig.json && node tests/.ts-out/tests/run-tests.js",
    "snapshot:barrel": "node scripts/tsc.mjs -p tests/tsconfig.json && node tests/.ts-out/tests/run-tests.js --update-barrel",
    "check:dist": "node scripts/check-dist.mjs",
    "pack:vendor": "node scripts/pack-vendor.mjs",
    "link:devdeps": "node scripts/link-dev-deps.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build && npm run check:dist"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
