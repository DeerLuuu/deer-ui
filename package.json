{
  "name": "deer-ui",
  "version": "0.1.0",
  "private": true,
  "description": "deer-ui — 独立的 React 18 控件库：控件的 DOM 契约、行为与无障碍属性，自带设计令牌与控件样式（deer-ui/styles.css），零运行时依赖（react/react-dom 仅为 peer）。bundler-only：相对 import 不带 .js 后缀、不发 CJS；v0 不发 npm，只以 tarball 交付（见 README）。",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "node scripts/tsc.mjs -p tsconfig.json --noEmit && node scripts/tsc.mjs -p tsconfig.examples.json",
    "build": "node scripts/tsc.mjs -p tsconfig.build.json && node scripts/build-styles.mjs",
    "test:build": "node scripts/tsc.mjs -p tests/tsconfig.json",
    "test": "node scripts/tsc.mjs -p tests/tsconfig.json && node tests/.ts-out/tests/run-tests.js",
    "snapshot:barrel": "node scripts/tsc.mjs -p tests/tsconfig.json && node tests/.ts-out/tests/run-tests.js --update-barrel",
    "check:dist": "node scripts/check-dist.mjs",
    "pack:vendor": "node scripts/pack-vendor.mjs",
    "link:devdeps": "node scripts/link-dev-deps.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build && npm run check:dist"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
